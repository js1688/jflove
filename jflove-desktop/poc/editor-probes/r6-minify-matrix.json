      "output": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><root><!--c--><a><![CDATA[ x < y ]]></a><br/><img src=\"x\"/><keep>hello   world</keep><sp></sp><mix>This is <b>some</b> content.</mix></root>",
      "error": null
    }
  ],
