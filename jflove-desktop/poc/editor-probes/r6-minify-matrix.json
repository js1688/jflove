    {
      "id": "m9-minify-space-in-mixed",
      "title": "压缩：空格文本节点夹在元素之间 <b>y</b> <c>z</c>",
      "mode": "minify",
      "opts": {},
      "input": "<root><b>y</b> <c>z</c></root>",
      "output": "<root><b>y</b><c>z</c></root>",
      "error": null
    },
    {
      "id": "m10-minify-xmlspace-in-mixed",
      "title": "压缩：xml:space=\"preserve\" 能否保住 <b>y</b> <c>z</c> 之间的空格",
      "mode": "minify",
      "opts": {},
      "input": "<root xml:space=\"preserve\"><b>y</b> <c>z</c></root>",
      "output": "<root xml:space=\"preserve\"><b>y</b> <c>z</c></root>",
      "error": null
    },
    {
      "id": "v1-format-recommended",
      "title": "推荐参数下的格式化（AC-33 样例）",
      "mode": "format",
      "opts": {
        "indentation": "  ",
        "lineSeparator": "\n",
        "attributeQuotes": "double",
        "collapseContent": true,
        "strictMode": true,
        "throwOnFailure": true,
        "whiteSpaceAtEndOfSelfclosingTag": false
      },
      "input": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<root><!--c--><a><![CDATA[ x < y ]]></a><br/><img src=\"x\" /><keep>hello   world</keep><sp> </sp><mix>This is <b>some</b> content.</mix></root>",
      "output": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<root>\n  <!--c-->\n  <a><![CDATA[ x < y ]]></a>\n  <br/>\n  <img src=\"x\"/>\n  <keep>hello   world</keep>\n  <sp></sp>\n  <mix>This is <b>some</b> content.</mix>\n</root>",
      "error": null
    },
    {
      "id": "v2-minify-recommended",
      "title": "推荐参数下的压缩（AC-33 样例）",
      "mode": "minify",
      "opts": {
