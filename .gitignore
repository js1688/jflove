# 文件作用：告诉 Git 忽略哪些文件或目录，避免将依赖包、编译产物、敏感信息等提交到仓库。

# 依赖
node_modules/

# Python 虚拟环境（支持 Linux / Windows / macOS 多平台共存）
venv/
venv-linux/
venv-win/
venv-mac/
__pycache__/
.pytest_cache

# 编译输出
dist/
build/

# AI 计划临时文件（plans/）——整个目录不入库
#
# 定位：plans/ 只装**本次版本工作**的临时计划（开工前列、完工后可弃），
# 属于本地草稿，**不跨设备同步**。
# ⇒ 因此**任何受控文件都不得按路径引用 plans/ 下的具体文件**（源码 / 打包脚本 / CI /
#   文档记录 都算）—— 否则就是把"单一真相"放在一台机器上，换设备即悬空。
#   需要长期留存的结论请写进 文档记录/ 或 AGENTS.md，不要写进 plans/。
plans

# 环境变量文件（包含密钥）
.env
.env.local
.env.*.local

# IDE 配置
# .vscode/ 保留启动配置，可指引开发启动
.idea/

# 系统文件
.DS_Store
Thumbs.db

# 数据库文件
# jflove-dev.db 为开发数据，不提交
# jflove-prod.db 为生产空表结构，需提交
jflove-db/jflove-dev.db

# 运行时日志（可能含本地路径、用户名等个人隐私）
logs/

# 桌面端运行时数据（服务器地址历史、会话等，实际存于系统用户数据目录，
# 项目内的 storage/ 为旧版遗留文件，仅做启动迁移读取，无需提交）
jflove-desktop/storage/

# Flutter / Dart 相关
.dart_tool/
.pub-cache/
.pub/
.flutter-plugins
.flutter-plugins-dependencies
jflove-app/*.iml
jflove-app/android/*.iml
jflove-app/coverage/

# jflove-web 相关（React + Vite + TypeScript）
jflove-web/node_modules/
jflove-web/dist/
jflove-web/coverage/
# TypeScript 增量编译缓存（tsc -b 生成，构建时自动重建）
jflove-web/tsconfig.tsbuildinfo

# 首次只做 Android，暂不需要的桌面平台目录
jflove-app/linux/
jflove-app/macos/
jflove-app/windows/

# Android 构建缓存与本地配置（jflove-app）
jflove-app/android/.gradle/
jflove-app/android/.kotlin/
jflove-app/android/.cxx/
jflove-app/android/captures/
jflove-app/android/local.properties
jflove-app/android/key.properties
jflove-app/android/**/*.keystore
jflove-app/android/**/*.jks

# 桌面端 PoC：护栏临时文件（含会话令牌/测试账号口令，严禁入库）与自动化截图
jflove-desktop/poc/**/.tmp_*
jflove-desktop/poc/login-shell/out/

# 桌面端前端：离线 vendor 包由脚本生成（mermaid 由 scripts/build_mermaid_bundle.mjs + 
# build.py::ensure_mermaid_bundle() 产出/复制；editor 包同理）—— 整个目录不入库
jflove-desktop/ui/public/vendor/

# 说明（有意跟踪，勿"顺手清理"）——
#   jflove-web/public/vendor/mermaid.bundle.js + mermaid.version.json
#   jflove-app/assets/mermaid/mermaid.bundle.js
# 这两处目前**受版本控制**，因为 CI 在对应 job 里没有生成步骤：
#   build-web.yml 直接 `cd jflove-web && python build.py`（Dockerfile `COPY . .` 后 `npm run build`）；
#   build-app.yml 直接 `flutter build apk --release`。
# ⇒ 现在删掉它们会**直接弄崩 web 与 app 的线上构建**。
# 若将来要统一成"三端都生成、都不入库"（可省 6.7 MB），必须**同时**给两个 workflow 补生成步骤，
# 并保持与 scripts/build_mermaid_bundle.mjs 的 TARGETS 一致；改完必须实跑一次对应 workflow 才算数。
